omas\\WEBDEVELOPMENT\\Poyectos\\FARMACIA\\FARMACIA-AP\\client\\src\\components\\CardObraSocial.jsx",[],["207","208"],"E:\\d\\Tomas\\WEBDEVELOPMENT\\Poyectos\\FARMACIA\\FARMACIA-AP\\client\\src\\components\\ObraSocialCreate.jsx",[],"E:\\d\\Tomas\\WEBDEVELOPMENT\\Poyectos\\FARMACIA\\FARMACIA-AP\\client\\src\\components\\ObraSocialEdit.jsx",[],"E:\\d\\Tomas\\WEBDEVELOPMENT\\Poyectos\\FARMACIA\\FARMACIA-AP\\client\\src\\components\\NavBar.jsx",[],"E:\\d\\Tomas\\WEBDEVELOPMENT\\Poyectos\\FARMACIA\\FARMACIA-AP\\client\\src\\components\\Layout.jsx",[],"E:\\d\\Tomas\\WEBDEVELOPMENT\\Poyectos\\FARMACIA\\FARMACIA-AP\\client\\src\\components\\LoginButton.jsx",[],"E:\\d\\Tomas\\WEBDEVELOPMENT\\Poyectos\\FARMACIA\\FARMACIA-AP\\client\\src\\components\\Profile.jsx",[],"E:\\d\\Tomas\\WEBDEVELOPMENT\\Poyectos\\FARMACIA\\FARMACIA-AP\\client\\src\\components\\LogoutButton.jsx",[],"E:\\d\\Tomas\\WEBDEVELOPMENT\\Poyectos\\FARMACIA\\FARMACIA-AP\\client\\src\\components\\AccesoDenegado.jsx",[],"E:\\d\\Tomas\\WEBDEVELOPMENT\\Poyectos\\FARMACIA\\FARMACIA-AP\\client\\src\\components\\ProtectedRoute.jsx",[],"E:\\d\\Tomas\\WEBDEVELOPMENT\\Poyectos\\DemoFarmacia\\DemoFarmacia\\client\\src\\index.js",[],["209","210"],"E:\\d\\Tomas\\WEBDEVELOPMENT\\Poyectos\\DemoFarmacia\\DemoFarmacia\\client\\src\\redux\\store.js",[],"E:\\d\\Tomas\\WEBDEVELOPMENT\\Poyectos\\DemoFarmacia\\DemoFarmacia\\client\\src\\App.js",[],"E:\\d\\Tomas\\WEBDEVELOPMENT\\Poyectos\\DemoFarmacia\\DemoFarmacia\\client\\src\\components\\LandingPage.jsx",[],"E:\\d\\Tomas\\WEBDEVELOPMENT\\Poyectos\\DemoFarmacia\\DemoFarmacia\\client\\src\\components\\Home.jsx",["211"],"E:\\d\\Tomas\\WEBDEVELOPMENT\\Poyectos\\DemoFarmacia\\DemoFarmacia\\client\\src\\components\\ClientCreate.jsx",["212"],"import React, { useState, useEffect } from \"react\";\nimport { Link, useNavigate } from 'react-router-dom';\nimport { useDispatch, useSelector } from \"react-redux\";\nimport { postCliente } from \"../redux/slices/clientesSlice\";\nimport { getObrasSociales } from \"../redux/slices/obrasSocialesSlice\";\nimport 'bootstrap/dist/css/bootstrap.min.css';\nimport { Form, FormGroup, Label, Col, Input, Button, Container, \n          Dropdown, DropdownToggle, DropdownMenu, DropdownItem, \n          Alert, Badge, Card, Spinner } from 'reactstrap';\n\nfunction validate(input){\n  let errors = {};\n  if(!input.nombre) {\n    errors.nombre = \"se requiere un nombre\";\n  } \n  if(!input.apellido) {\n    errors.apellido = \"se requiere un apellido\";\n  }\n  if(!input.dni) {\n    errors.dni = \"se requiere un DNI\";\n  }\n  return errors;\n}\n\nexport default function ClientCreate(){\n  const dispatch = useDispatch();\n  const navigate = useNavigate();\n  \n  const { obrasSocialesList, isLoading: osLoading } = useSelector((state) => state.obrasSociales);\n  const { isLoading: clientLoading } = useSelector((state) => state.clientes);\n\n  const [selectedObraSocial, setSelectedObraSocial] = useState(\"\");\n  const [errors, setErrors] = useState({});\n  const [dropdownOpen, setDropdownOpen] = useState(false);\n  const toggleDropdown = () => setDropdownOpen(!dropdownOpen);\n  \n  const [input, setInput] = useState({\n    nombre: '',\n    apellido: '',\n    puntos: 0,\n    dni: '',\n    numeroDeAfiliado: '',\n    direccion: '',\n    telefono: '',\n    notas: '',\n    obraSocial: []\n  });\n\n  function handleChange(e){\n    setInput({\n      ...input,\n      [e.target.name] : e.target.value\n    });\n    setErrors(validate({\n      ...input,\n      [e.target.name] : e.target.value\n    }));\n  }\n\n  function handleSelect(e){\n    if(e.target.value && !input.obraSocial.includes(e.target.value)){\n      setInput({\n        ...input,\n        obraSocial: [...input.obraSocial, e.target.value]\n      });\n      setSelectedObraSocial(\"\");\n    }\n  }\n\n  function handleDelete(el){\n    setInput({\n      ...input,\n      obraSocial: input.obraSocial.filter(os => os !== el)\n    });\n  }\n\n  async function handleSubmit(e){\n    e.preventDefault();\n    try {\n      await dispatch(postCliente(input)).unwrap();\n      alert('¡Cliente creado con éxito!');\n      setInput({\n        nombre: '',\n        apellido: '',\n        puntos: 0,\n        dni: '',\n        numeroDeAfiliado: '',\n        direccion: '',\n        telefono: '',\n        notas: '',\n        obraSocial: []\n      });\n      navigate('/clientes');\n    } catch (err) {\n      alert('Error al crear cliente: ' + err);\n    }\n  }\n\n  useEffect(()=>{\n    dispatch(getObrasSociales());\n  }, [dispatch]);\n\n  return(\n    <Container className=\"mt-5\">\n      <Card className=\"p-4 shadow w-75\">\n        <h1>Crear Nuevo Cliente</h1>\n        <Form className=\"mt-4\" onSubmit={handleSubmit} onKeyDown={(e) => e.key === 'Enter' && e.preventDefault()}>\n          <FormGroup row>\n            <Label for='nombre' sm={2}><h5>Nombre*</h5></Label>\n            <Col sm={8}>\n              <Input id='nombre' type=\"text\" value={input.nombre} name='nombre' onChange={handleChange}/>\n              {errors.nombre && (<Alert color=\"danger\" className=\"mt-2\">{errors.nombre}</Alert>)}\n            </Col>\n          </FormGroup>\n          <FormGroup row>\n            <Label for='apellido' sm={2}><h5>Apellido*</h5></Label>\n            <Col sm={8}>\n              <Input id='apellido' type=\"text\" value={input.apellido} name='apellido' onChange={handleChange}/>\n              {errors.apellido && (<Alert color=\"danger\" className=\"mt-2\">{errors.apellido}</Alert>)}\n            </Col>\n          </FormGroup>\n          <FormGroup row>\n            <Label for='dni' sm={2}><h5>D.N.I*</h5></Label>\n            <Col sm={8}>\n              <Input id='dni' type=\"text\" value={input.dni} name='dni' onChange={handleChange}/>\n              {errors.dni && (<Alert color=\"danger\" className=\"mt-2\">{errors.dni}</Alert>)}\n            </Col>\n          </FormGroup>\n          <FormGroup row>\n            <Label for='puntos' sm={2}><h5>Puntos</h5></Label>\n            <Col sm={8}>\n              <Input id='puntos' type=\"number\" value={input.puntos} name='puntos' onChange={handleChange}/>\n            </Col>\n          </FormGroup>\n          <FormGroup row>\n            <Label for='numeroDeAfiliado' sm={2}><h5>Numero de Afiliado</h5></Label>\n            <Col sm={8}>\n              <Input id='numeroDeAfiliado' type=\"text\" value={input.numeroDeAfiliado} name='numeroDeAfiliado' onChange={handleChange}/>\n            </Col>\n          </FormGroup>\n          <FormGroup row>\n            <Label for='direccion' sm={2}><h5>Dirección</h5></Label>\n            <Col sm={8}>\n              <Input id='dirección' type=\"text\" value={input.direccion} name='direccion' onChange={handleChange}/>\n            </Col>\n          </FormGroup>\n          <FormGroup row>\n            <Label for='telefono' sm={2}><h5>Teléfono</h5></Label>\n            <Col sm={8}>\n              <Input id='telefono' type=\"text\" value={input.telefono} name='telefono' onChange={handleChange}/>\n            </Col>\n          </FormGroup>\n          <FormGroup row>\n            <Label for='notas' sm={2}><h5>Notas</h5></Label>\n            <Col sm={8}>\n              <Input id='notas' type=\"textarea\" value={input.notas} name='notas' onChange={handleChange}/>\n            </Col>\n          </FormGroup>\n          \n          <FormGroup row>\n            <Label for='obrasSociales' sm={2}><h5>Obras Sociales</h5></Label>\n            <Col sm={4}>\n              {osLoading ? (\n                <Spinner size=\"sm\" color=\"primary\" />\n              ) : (\n                <Dropdown isOpen={dropdownOpen} toggle={toggleDropdown} className=\"d-inline-block\">\n                  <DropdownToggle caret className=\"third-button\">elige una obra social</DropdownToggle>\n                  <DropdownMenu>\n                    {obrasSocialesList.map((os) => (\n                      <DropdownItem key={os.id} value={os.nombre} onClick={handleSelect}>\n                        {os.nombre.toUpperCase()}\n                      </DropdownItem>\n                    ))}\n                  </DropdownMenu>\n                </Dropdown>\n              )}\n            </Col>\n          </FormGroup>\n          <FormGroup row>\n            <Col sm={12} className=\"d-flex align-items-center flex-wrap\">\n              {input.obraSocial.map((el, index) => \n                <h4 key={el + index}>\n                  <Badge className=\"me-2 os-badge\" pill>{el.toUpperCase()}\n                    <button type=\"button\" className=\"close-badge\" onClick={() => handleDelete(el)}><h4>x</h4></button>  \n                  </Badge>\n                </h4>\n              )}\n            </Col>\n          </FormGroup>\n            \n          <br/>\n          {clientLoading ? (\n            <Spinner color=\"primary\" className=\"mb-4\" />\n          ) : (\n            <>\n              {Object.keys(errors).length ? (\n                <Button className=\"mb-4 first-button\" type=\"submit\" disabled>crear</Button>\n              ) : (\n                <Button className=\"mb-4 first-button\" type=\"submit\">crear</Button>\n              )}\n            </>\n          )}\n          <Link to={'/clientes'}><Button className=\"ms-2 mb-4 second-button\">cancelar</Button></Link>\n        </Form>\n      </Card>\n    </Container>\n  );\n}","E:\\d\\Tomas\\WEBDEVELOPMENT\\Poyectos\\DemoFarmacia\\DemoFarmacia\\client\\src\\components\\ClientEdit.jsx",["213"],"import React, { useState, useEffect } from \"react\";\nimport { Link, useNavigate, useParams } from 'react-router-dom';\nimport { useDispatch, useSelector } from \"react-redux\";\nimport { editCliente, getClienteById, clearClienteDetail } from \"../redux/slices/clientesSlice\";\nimport { getObrasSociales } from \"../redux/slices/obrasSocialesSlice\";\nimport CalculadoraPuntos from \"./CalculadoraPuntos\";\nimport 'bootstrap/dist/css/bootstrap.min.css';\nimport { Form, FormGroup, Label, Col, Input, Button, Container, \n          Dropdown, DropdownToggle, DropdownMenu, DropdownItem, Card, Badge, Spinner } from 'reactstrap';\n\nexport default function ClientEdit() {\n  const dispatch = useDispatch();\n  const { id } = useParams();\n  const navigate = useNavigate();\n  \n  const { obrasSocialesList, isLoading: osLoading } = useSelector((state) => state.obrasSociales);\n  const { clienteDetail, isLoading: clientLoading } = useSelector((state) => state.clientes);\n  \n  const [selectedObraSocial, setSelectedObraSocial] = useState(\"\");\n  const [dropdownOpen, setDropdownOpen] = useState(false);\n  const toggleDropdown = () => setDropdownOpen(!dropdownOpen);\n  \n  const [input, setInput] = useState({\n    nombre: \"\",\n    apellido: \"\",\n    puntos: 0,\n    dni: \"\",\n    numeroDeAfiliado: \"\",\n    direccion: \"\",\n    telefono: \"\",\n    notas: \"\",\n    obraSocial: [],\n  });\n\n  useEffect(() => {\n    dispatch(getClienteById(id));\n    dispatch(getObrasSociales());\n    return () => {\n      dispatch(clearClienteDetail());\n    };\n  }, [dispatch, id]);\n\n  useEffect(() => {\n    if (clienteDetail) {\n      setInput({\n        nombre: clienteDetail.nombre || \"\",\n        apellido: clienteDetail.apellido || \"\",\n        puntos: clienteDetail.puntos || 0,\n        dni: clienteDetail.dni || \"\",\n        numeroDeAfiliado: clienteDetail.numeroDeAfiliado || \"\",\n        direccion: clienteDetail.direccion || \"\",\n        telefono: clienteDetail.telefono || \"\",\n        notes: clienteDetail.notas || \"\", // API maps notes to notas\n        notas: clienteDetail.notas || \"\",\n        obraSocial: clienteDetail.obraSocials?.map(os => os.nombre) || [],\n      });\n    }\n  }, [clienteDetail]);\n\n  const handleChange = (e) => {\n    setInput({\n      ...input,\n      [e.target.name]: e.target.value,\n    });\n  };\n\n  const handleSelectChange = (e) => {\n    const selectedValue = e.target.value;\n    if (selectedValue && !input.obraSocial.includes(selectedValue)) {\n      setInput({\n        ...input,\n        obraSocial: [...input.obraSocial, selectedValue],\n      });\n      setSelectedObraSocial(\"\");\n    }\n  };\n\n  const handleSubmit = async (e) => {\n    e.preventDefault();\n    try {\n      await dispatch(editCliente({ id, payload: input })).unwrap();\n      alert(\"Cliente actualizado con éxito.\");\n      navigate(\"/clientes\");\n    } catch (err) {\n      alert(\"Error al actualizar cliente: \" + err);\n    }\n  };\n\n  function handleDelete(el) {\n    setInput({\n      ...input,\n      obraSocial: input.obraSocial.filter(os => os !== el)\n    });\n  }\n\n  function sumarPuntos(puntosSumados) {\n    setInput({\n      ...input,\n      puntos: puntosSumados\n    });\n  }\n\n  function canjearPuntos(puntosCanjeados) {\n    setInput({\n      ...input,\n      puntos: puntosCanjeados\n    });\n  }\n\n  return (\n    <Container className=\"mt-5\">\n      <div className=\"d-flex gap-4 align-items-start\">\n        <Card className=\"p-4 shadow w-75\">\n          <h1>EDITAR CLIENTE</h1>\n          {clientLoading && !clienteDetail ? (\n            <div className=\"text-center my-5\">\n              <Spinner color=\"primary\" />\n              <p>Cargando cliente...</p>\n            </div>\n          ) : (\n            <Form onSubmit={handleSubmit} onKeyDown={(e) => e.key === 'Enter' && e.preventDefault()}>\n              <FormGroup row>\n                <Label for='nombre' sm={2}><h5>Nombre</h5></Label>\n                <Col sm={8}>\n                  <Input id=\"nombre\" type=\"text\" value={input.nombre} onChange={handleChange} name=\"nombre\" />\n                </Col>\n              </FormGroup>\n              <FormGroup row>\n                <Label for='apellido' sm={2}><h5>Apellido</h5></Label>\n                <Col sm={8}>\n                  <Input id=\"apellido\" type=\"text\" value={input.apellido} onChange={handleChange} name=\"apellido\" />\n                </Col>\n              </FormGroup>\n              <FormGroup row>\n                <Label for='puntos' sm={2}><h5>Puntos</h5></Label>\n                <Col sm={8}>\n                  <Input id='puntos' type=\"number\" value={input.puntos} name='puntos' onChange={handleChange} />\n                </Col>\n              </FormGroup>\n              <FormGroup row>\n                <Label for='dni' sm={2}><h5>D.N.I</h5></Label>\n                <Col sm={8}>\n                  <Input id='dni' type=\"text\" value={input.dni} name='dni' onChange={handleChange} />\n                </Col>\n              </FormGroup>\n              <FormGroup row>\n                <Label for='numeroDeAfiliado' sm={2}><h5>Numero de Afiliado</h5></Label>\n                <Col sm={8}>\n                  <Input id='numeroDeAfiliado' type=\"text\" value={input.numeroDeAfiliado} name='numeroDeAfiliado' onChange={handleChange} />\n                </Col>\n              </FormGroup>\n              <FormGroup row>\n                <Label for='direccion' sm={2}><h5>Dirección</h5></Label>\n                <Col sm={8}>\n                  <Input id='dirección' type=\"text\" value={input.direccion} name='direccion' onChange={handleChange} />\n                </Col>\n              </FormGroup>\n              <FormGroup row>\n                <Label for='telefono' sm={2}><h5>Teléfono</h5></Label>\n                <Col sm={8}>\n                  <Input id='telefono' type=\"text\" value={input.telefono} name='telefono' onChange={handleChange} />\n                </Col>\n              </FormGroup>\n              <FormGroup row>\n                <Label for='notas' sm={2}><h5>Notas</h5></Label>\n                <Col sm={8}>\n                  <Input id='notas' type=\"textarea\" value={input.notas} name='notas' onChange={handleChange} />\n                </Col>\n              </FormGroup>\n              <div>\n                <Label for='obrasSociales' sm={2}><h5>Obras Sociales</h5></Label>\n                {osLoading ? (\n                  <Spinner size=\"sm\" color=\"primary\" />\n                ) : (\n                  <Dropdown isOpen={dropdownOpen} toggle={toggleDropdown} className=\"d-inline-block\">\n                    <DropdownToggle caret className=\"third-button\">elige una obra social</DropdownToggle>\n                    <DropdownMenu>\n                      {obrasSocialesList.map((os) => (\n                        <DropdownItem key={os.id} value={os.nombre} onClick={handleSelectChange}>{os.nombre.toUpperCase()}</DropdownItem>\n                      ))}\n                    </DropdownMenu>\n                  </Dropdown>\n                )}\n                <FormGroup row>\n                  <Col sm={12} className=\"d-flex align-items-center flex-wrap mt-2\">\n                    {input.obraSocial.map((el, index) => \n                      <h4 key={el + index}>\n                        <Badge className=\"me-2 os-badge\" pill>{el.toUpperCase()}\n                          <button type=\"button\" className=\"close-badge\" onClick={() => handleDelete(el)}><h4>x</h4></button>  \n                        </Badge>\n                      </h4>\n                    )}\n                  </Col>\n                </FormGroup>\n              </div>\n              <br />\n              {clientLoading ? (\n                <Spinner color=\"primary\" />\n              ) : (\n                <Button className=\"me-2 mb-4 first-button\" type=\"submit\">editar</Button>\n              )}\n              <Link to={'/clientes'}><Button className=\"mb-4\" color=\"dark\">cancelar</Button></Link>\n            </Form>\n          )}\n        </Card>\n        <div className=\"w-25\">\n          <CalculadoraPuntos\n            argPuntos={input.puntos}\n            sumarPuntos={sumarPuntos}\n            canjearPuntos={canjearPuntos}\n          />\n        </div>\n      </div>\n    </Container>\n  );\n}","E:\\d\\Tomas\\WEBDEVELOPMENT\\Poyectos\\DemoFarmacia\\DemoFarmacia\\client\\src\\components\\Detail.jsx",[],"E:\\d\\Tomas\\WEBDEVELOPMENT\\Poyectos\\DemoFarmacia\\DemoFarmacia\\client\\src\\components\\ObraSocialCreate.jsx",[],"E:\\d\\Tomas\\WEBDEVELOPMENT\\Poyectos\\DemoFarmacia\\DemoFarmacia\\client\\src\\components\\ObrasSociales.jsx",["214"],"E:\\d\\Tomas\\WEBDEVELOPMENT\\Poyectos\\DemoFarmacia\\DemoFarmacia\\client\\src\\components\\ObraSocialEdit.jsx",[],"E:\\d\\Tomas\\WEBDEVELOPMENT\\Poyectos\\DemoFarmacia\\DemoFarmacia\\client\\src\\components\\Layout.jsx",[],"E:\\d\\Tomas\\WEBDEVELOPMENT\\Poyectos\\DemoFarmacia\\DemoFarmacia\\client\\src\\components\\ProtectedRoute.jsx",[],"E:\\d\\Tomas\\WEBDEVELOPMENT\\Poyectos\\DemoFarmacia\\DemoFarmacia\\client\\src\\components\\AccesoDenegado.jsx",[],"E:\\d\\Tomas\\WEBDEVELOPMENT\\Poyectos\\DemoFarmacia\\DemoFarmacia\\client\\src\\components\\Profile.jsx",[],["215","216"],"E:\\d\\Tomas\\WEBDEVELOPMENT\\Poyectos\\DemoFarmacia\\DemoFarmacia\\client\\src\\components\\LoginButton.jsx",[],"E:\\d\\Tomas\\WEBDEVELOPMENT\\Poyectos\\DemoFarmacia\\DemoFarmacia\\client\\src\\components\\LogoutButton.jsx",[],"E:\\d\\Tomas\\WEBDEVELOPMENT\\Poyectos\\DemoFarmacia\\DemoFarmacia\\client\\src\\components\\Paginado.jsx",[],"E:\\d\\Tomas\\WEBDEVELOPMENT\\Poyectos\\DemoFarmacia\\DemoFarmacia\\client\\src\\components\\SearchBar.jsx",[],"E:\\d\\Tomas\\WEBDEVELOPMENT\\Poyectos\\DemoFarmacia\\DemoFarmacia\\client\\src\\components\\NavBar.jsx",[],"E:\\d\\Tomas\\WEBDEVELOPMENT\\Poyectos\\DemoFarmacia\\DemoFarmacia\\client\\src\\components\\CalculadoraPuntos.jsx",[],"E:\\d\\Tomas\\WEBDEVELOPMENT\\Poyectos\\DemoFarmacia\\DemoFarmacia\\client\\src\\redux\\slices\\clientesSlice.js",[],"E:\\d\\Tomas\\WEBDEVELOPMENT\\Poyectos\\DemoFarmacia\\DemoFarmacia\\client\\src\\redux\\slices\\obrasSocialesSlice.js",[],{"ruleId":"217","replacedBy":"218"},{"ruleId":"219","replacedBy":"220"},{"ruleId":"217","replacedBy":"221"},{"ruleId":"219","replacedBy":"222"},{"ruleId":"217","replacedBy":"223"},{"ruleId":"219","replacedBy":"224"},{"ruleId":"217","replacedBy":"225"},{"ruleId":"219","replacedBy":"226"},{"ruleId":"227","severity":1,"message":"228","line":15,"column":10,"nodeType":"229","messageId":"230","endLine":15,"endColumn":15},{"ruleId":"227","severity":1,"message":"231","line":32,"column":10,"nodeType":"229","messageId":"230","endLine":32,"endColumn":28},{"ruleId":"227","severity":1,"message":"231","line":19,"column":10,"nodeType":"229","messageId":"230","endLine":19,"endColumn":28},{"ruleId":"227","severity":1,"message":"228","line":15,"column":10,"nodeType":"229","messageId":"230","endLine":15,"endColumn":15},{"ruleId":"217","replacedBy":"232"},{"ruleId":"219","replacedBy":"233"},"no-native-reassign",["234"],"no-negated-in-lhs",["235"],["234"],["235"],["234"],["235"],["234"],["235"],"no-unused-vars","'orden' is assigned a value but never used.","Identifier","unusedVar","'selectedObraSocial' is assigned a value but never used.",["234"],["235"],"no-global-assign","no-unsafe-negation"]